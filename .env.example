# MongoDB connection string (local, Docker or Atlas)
MONGODB_URI=mongodb://127.0.0.1:27017/solar_design
# Long random string used to sign session tokens
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that become administrators when they sign in (maintain the shared equipment library)
ADMIN_EMAILS=

# Public address of the site (used for canonical links, sitemap.xml, robots.txt and share previews)
NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Optional search-engine ownership tokens (Google Search Console / Bing Webmaster Tools)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# NIPOST digital postcodes (https://dashboard.postcode.gov.ng → Settings → API Keys). All optional:
# without them the NIPOST location method still works (map pin / GPS), but postcodes are not verified.
# Secret key (scopes: search, lookup). Server-side only, never exposed to the browser.
# nipost_test_… keys only resolve NIPOST's sandbox; live keys need verified KYB.
NIPOST_API_KEY=
# NIPOST_API_BASE=https://api.postcode.gov.ng
# Publishable key (nipost_pk_…, widget scope) for the "Find in NIPOST" widget. Add this site's origins
# (production and http://localhost:3000) to the key's allowlist in the NIPOST dashboard.
NEXT_PUBLIC_NIPOST_PUBLISHABLE_KEY=
# "production" (default) or "staging" (needed for test keys)
NEXT_PUBLIC_NIPOST_ENV=production
# Widget script URL; the default is the CDN address in NIPOST's docs (not yet published as of Oct 2026)
# NEXT_PUBLIC_NIPOST_WIDGET_SRC=https://unpkg.com/@nipost/postcode-widget@0.1.0/dist/sdk.js
